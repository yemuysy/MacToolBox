<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 主程序保持非沙盒，以兼容 SMC 温度读取 / 磁盘挂载 / 截图等需广泛系统访问的功能。
         仅添加 App Group  entitlement，使沙盒化的 Finder Sync 扩展能与之跨进程通信。 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.yemu.mactoolbox</string>
    </array>
    <key>com.apple.developer.team-identifier</key>
    <string>__TEAM_ID__</string>
    <key>com.apple.security.application-identifier</key>
    <string>__TEAM_ID__.com.yemu.mactoolbox</string>
</dict>
</plist>
