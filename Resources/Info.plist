<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MacToolBox</string>
    <key>CFBundleDisplayName</key>
    <string>MacToolBox</string>
    <key>CFBundleIdentifier</key>
    <string>com.yemu.mactoolbox</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>MacToolBox</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>MacToolBox needs to send Apple events to manage disks and inspect running applications.</string>

	<!-- 右键增强（免费路线）：系统服务，无需证书、无需 Finder Sync 扩展。
	     出现在 Finder 右键「服务」子菜单，复用主程序 RightClickActionHandlers。
	     注意：NSServices 受 macOS 设计限制，只能出现在「服务」子菜单，无法置顶到
	     右键一级菜单；要一级菜单必须用 Finder Sync 扩展（需签名）。 -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>MacToolBox：复制路径</string></dict>
			<key>NSMessage</key>
			<string>rightClickService</string>
			<key>NSPortName</key>
			<string>com.yemu.mactoolbox</string>
			<key>NSUserData</key>
			<string>copyPath</string>
			<key>NSSendTypes</key>
			<array><string>NSFilenamesPboardType</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>MacToolBox：新建文件</string></dict>
			<key>NSMessage</key>
			<string>rightClickService</string>
			<key>NSPortName</key>
			<string>com.yemu.mactoolbox</string>
			<key>NSUserData</key>
			<string>newFile</string>
			<key>NSSendTypes</key>
			<array><string>NSFilenamesPboardType</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>MacToolBox：用 App 打开</string></dict>
			<key>NSMessage</key>
			<string>rightClickService</string>
			<key>NSPortName</key>
			<string>com.yemu.mactoolbox</string>
			<key>NSUserData</key>
			<string>openWith</string>
			<key>NSSendTypes</key>
			<array><string>NSFilenamesPboardType</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>MacToolBox：删除</string></dict>
			<key>NSMessage</key>
			<string>rightClickService</string>
			<key>NSPortName</key>
			<string>com.yemu.mactoolbox</string>
			<key>NSUserData</key>
			<string>delete</string>
			<key>NSSendTypes</key>
			<array><string>NSFilenamesPboardType</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>MacToolBox：显示/隐藏</string></dict>
			<key>NSMessage</key>
			<string>rightClickService</string>
			<key>NSPortName</key>
			<string>com.yemu.mactoolbox</string>
			<key>NSUserData</key>
			<string>toggleHidden</string>
			<key>NSSendTypes</key>
			<array><string>NSFilenamesPboardType</string></array>
		</dict>
	</array>
</dict>
</plist>
